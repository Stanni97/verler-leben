<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>VerlerLeben</AssemblyName>
    <RootNamespace>VerlerLeben</RootNamespace>
    <!-- Keep in sync with VerlerLebenPlugin.PluginVersion. -->
    <Version>1.2.1</Version>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

    <!-- Compile against the game's own runtime libraries, so no .NET Framework
         reference assemblies (and no NuGet download) are needed on any OS. -->
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>

  <!-- StanniUpdater reads this to know where the mod's updates come from. -->
  <ItemGroup>
    <AssemblyMetadata Include="UpdateRepo" Value="Stanni97/verler-leben" />
  </ItemGroup>

  <!-- Default Steam install locations. Override with: dotnet build -p:ValheimDir="/path/to/Valheim" -->
  <PropertyGroup Condition="'$(ValheimDir)' == '' and '$(OS)' == 'Windows_NT'">
    <ValheimDir>C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ValheimDir)' == '' and '$(OS)' != 'Windows_NT'">
    <ValheimDir>$(HOME)/.local/share/Steam/steamapps/common/Valheim</ValheimDir>
  </PropertyGroup>
  <PropertyGroup>
    <ManagedDir>$(ValheimDir)/valheim_Data/Managed</ManagedDir>
    <FrameworkPathOverride>$(ManagedDir)</FrameworkPathOverride>
    <PluginsDir>$(ValheimDir)/BepInEx/plugins</PluginsDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="$(ManagedDir)/mscorlib.dll" Private="false" />
    <Reference Include="$(ManagedDir)/netstandard.dll" Private="false" />
    <Reference Include="$(ManagedDir)/System.dll" Private="false" />
    <Reference Include="$(ManagedDir)/System.Core.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/UnityEngine.ParticleSystemModule.dll" Private="false" />
    <Reference Include="$(ManagedDir)/assembly_valheim.dll" Private="false" />
    <Reference Include="$(ManagedDir)/assembly_utils.dll" Private="false" />
    <Reference Include="$(ManagedDir)/assembly_guiutils.dll" Private="false" />
    <Reference Include="$(ValheimDir)/BepInEx/core/BepInEx.dll" Private="false" />
    <Reference Include="$(ValheimDir)/BepInEx/core/0Harmony.dll" Private="false" />
    <Reference Include="$(PluginsDir)/ValheimModding-Jotunn/Jotunn.dll" Condition="Exists('$(PluginsDir)/ValheimModding-Jotunn/Jotunn.dll')" Private="false" />
    <Reference Include="$(PluginsDir)/Jotunn.dll" Condition="Exists('$(PluginsDir)/Jotunn.dll')" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets/*.png" LogicalName="VerlerLeben.%(Filename).png" />
    <EmbeddedResource Include="Assets/*.bin" LogicalName="VerlerLeben.%(Filename).bin" />
    <None Remove="tools/**;Thunderstore/**;dist/**" />
  </ItemGroup>

  <Target Name="CheckValheimDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ManagedDir)/assembly_valheim.dll')"
           Text="Valheim not found at '$(ValheimDir)'. Pass the install folder with -p:ValheimDir=&quot;...&quot;" />
    <Error Condition="!Exists('$(ValheimDir)/BepInEx/core/BepInEx.dll')"
           Text="BepInEx is not installed in '$(ValheimDir)'. Install BepInExPack_Valheim first." />
    <Error Condition="!Exists('$(PluginsDir)/ValheimModding-Jotunn/Jotunn.dll') and !Exists('$(PluginsDir)/Jotunn.dll')"
           Text="Jotunn.dll not found in '$(PluginsDir)'. Install Jotunn first." />
  </Target>

  <!-- Copy the freshly built plugin into the game. Disable with -p:InstallToGame=false -->
  <Target Name="InstallToGame" AfterTargets="Build" Condition="'$(InstallToGame)' != 'false'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)/VerlerLeben" />
    <Message Importance="high" Text="Installed $(TargetFileName) to $(PluginsDir)/VerlerLeben" />
  </Target>

  <!-- Release builds also produce a Thunderstore / r2modman compatible zip in dist/. -->
  <Target Name="ThunderstorePackage" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <PropertyGroup>
      <PackageDir>$(BaseIntermediateOutputPath)thunderstore</PackageDir>
      <ManifestJson>
{
  "name": "VerlerLeben",
  "version_number": "$(Version)",
  "website_url": "https://github.com/Stanni97/verler-leben",
  "description": "Spexarder Pizza and Kaunitzer Teller: two baked Doener feasts for the Feaster, with lots of health and stamina.",
  "dependencies": [
    "denikson-BepInExPack_Valheim-5.4.2333",
    "ValheimModding-Jotunn-2.30.2"
  ]
}
      </ManifestJson>
    </PropertyGroup>
    <RemoveDir Directories="$(PackageDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageDir)/plugins" />
    <Copy SourceFiles="Thunderstore/icon.png;README.md;CHANGELOG.md;LICENSE" DestinationFolder="$(PackageDir)" />
    <WriteLinesToFile File="$(PackageDir)/manifest.json" Lines="$(ManifestJson.Trim())" Overwrite="true" />
    <MakeDir Directories="dist" />
    <ZipDirectory SourceDirectory="$(PackageDir)" DestinationFile="dist/VerlerLeben-$(Version).zip" Overwrite="true" />
    <Message Importance="high" Text="Packaged dist/VerlerLeben-$(Version).zip" />
  </Target>

</Project>
